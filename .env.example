# Teader — Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Required: MySQL Database ────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=teader_db

# Prisma connection string (same credentials as above)
DATABASE_URL="mysql://your_db_user:your_db_password@localhost:3306/teader_db"

# ─── Required: Auth ──────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex').then(console.log)"
# Or: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_BYTE_HEX_STRING

# ─── Optional: AI Features ───────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
# Leave unset to disable AI panel (shows "not configured" message)
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional: GitHub Integration (P2-2, future) ─────────────────────────────
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV=development
