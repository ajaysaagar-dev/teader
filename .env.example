# Teader — Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ─── Required: PostgreSQL Database ───────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5678
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DATABASE=teader_db

# Prisma connection string (same credentials as above)
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5678/teader_db"

# ─── Required: Auth ──────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_BYTE_HEX_STRING

# ─── Optional: GitHub Integration (future) ───────────────────────────────────
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# ─── Optional: WebSocket Broadcast Security ─────────────────────────────────
# Shared secret for server-to-server broadcast calls to the WS hub.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_BROADCAST_SECRET=REPLACE_WITH_A_RANDOM_HEX_STRING

# ─── App & SEO ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: Google Search Console verification token
# GOOGLE_SITE_VERIFICATION=your_google_verification_token
NODE_ENV=development
